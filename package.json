    "test:phase1": "node --experimental-strip-types src/tests/phase1-verification.ts",
    "test:phase2": "node --experimental-strip-types src/tests/phase2-verification.ts",
    "test:phase3": "node --experimental-strip-types src/tests/phase3-verification.ts",
    "test:phase4": "node --experimental-strip-types src/tests/phase4-verification.ts",
    "test:phase4-ui": "node --experimental-strip-types src/tests/phase4-ui-hardening-verification.ts",
    "test:phase4-carto": "node --experimental-strip-types src/tests/phase4-cartographic-verification.ts",
    "test:phase4-interaction": "node --experimental-strip-types src/tests/phase4-7-interaction-verification.ts",
    "test:all": "node --experimental-strip-types src/tests/phase1-verification.ts && node --experimental-strip-types src/tests/phase2-verification.ts && node --experimental-strip-types src/tests/phase3-verification.ts && node --experimental-strip-types src/tests/phase4-verification.ts && node --experimental-strip-types src/tests/phase4-ui-hardening-verification.ts && node --experimental-strip-types src/tests/phase4-cartographic-verification.ts && node --experimental-strip-types src/tests/phase4-7-interaction-verification.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types src/server.ts",
    "smoke": "node --experimental-strip-types src/cli/smoke.ts",
